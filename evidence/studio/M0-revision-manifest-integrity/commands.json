    {
      "phase": "browser_and_first-browser",
      "argv": [
        "node",
        "PINNED_PLAYWRIGHT_CLI",
        "test",
        "--config",
        "tests/e2e/playwright.config.ts",
        "tests/e2e/project-manifest-recovery.spec.ts",
        "tests/e2e/source-recovery-accessibility.spec.ts",
        "--grep",
        "project envelope recovery|recovery accessibility: native"
      ],
      "environment": {
        "node": "24.22.1",
        "STUDIO_BASE_URL": "original owned native launcher on an ephemeral loopback port",
        "STUDIO_BROWSER_DATA": "fresh unique project-local .studio-local/browser-tests root",
        "STUDIO_BROWSER_REPORT": "absolute project-local phase JSON report",
        "STUDIO_BROWSER_OUTPUT": "absolute project-local phase artifact root"
      },
      "launcherArgv": [
        ".venv/bin/python",
        "-I",
        "-m",
        "xverse_studio.host.launcher",
        "--data-dir",
        "ISOLATED_ROOT",
        "--port",
        "EPHEMERAL_PORT",
        "--static-dir",
        "apps/studio-web/dist"
      ],
      "ownership": "Only the original native launcher handle is terminated/waited after the browser process exits. Fixture file mutations require an actual existing browser-tests root and realpath identity."
