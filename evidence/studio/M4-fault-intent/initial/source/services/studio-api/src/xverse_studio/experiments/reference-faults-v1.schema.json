{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.xverse.io/studio/reference-faults/1.0/schema.json",
  "title": "Owned reference measurement-hold schedule intent 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "schedules"],
  "properties": {
    "version": {"const": "1.0"},
    "schedules": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["faultId", "observerRef", "field", "clockDomainRef", "activation", "recovery"],
        "properties": {
          "faultId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "observerRef": {"const": "state-observer"},
          "field": {"const": "measured"},
          "clockDomainRef": {"const": "simulation-time"},
          "activation": {"$ref": "#/$defs/position"},
          "recovery": {"$ref": "#/$defs/position"}
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object", "additionalProperties": false,
      "required": ["tick", "unit"],
      "properties": {
        "tick": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,7})$"},
        "unit": {"const": "us"}
      }
    }
  }
}
